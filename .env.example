# Hosted OpenAI API configuration (no Ollama required)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# For an Ollama local provider instead, use:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=llama3.2
